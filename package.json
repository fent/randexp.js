{
  "name": "randexp",
  "description": "Create random strings that match a given regular expression.",
  "keywords": [
    "regex",
    "regexp",
    "regular expression",
    "random",
    "test"
  ],
  "version": "0.5.3",
  "homepage": "http://fent.github.io/randexp.js/",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/randexp.js.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "main": "./dist/randexp.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "build:browser": "esbuild dist/randexp.js --bundle --minify --format=iife --global-name=RandExp --outfile=dist/randexp.min.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "nyc --extension .ts --reporter=lcov --reporter=text-summary npm run test:unit && npm run test:package",
    "test:unit": "mocha --require ts-node/register --ignore test/export-test.ts test/*-test.ts",
    "test:package": "mocha --require ts-node/register test/export-test.ts"
  },
  "dependencies": {
    "drange": "^2.0.1",
    "ret": "^0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "license": "MIT"
}
